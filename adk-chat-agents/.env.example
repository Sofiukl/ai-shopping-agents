# Use Vertex AI with Application Default Credentials (no API key)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: model for all agents (default gemini-2.5-flash)
# MODEL=gemini-2.5-flash-lite

# Optional, web UI / AG-UI server
# LOGIN_MODE=chat            # "form" is set automatically by `shop-agent-server`
# AGENT_PORT=8001
# SHOP_API_URL=http://127.0.0.1:8000
